# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# persisted tool output
tool-results/

# ── Audit cleanups (C2, repo hygiene) ──
# Real customer DB must never be committed (PII + credentials).
/db/
/db/*.db
/db/*.db-journal
# runtime uploads
/upload/
# agent/runtime artifacts
/tool-results/
/agent-ctx/
/.zscripts/
/.initial_snapshot.json
/worklog.md
.dev.log
server.out.log
download/

# OPS-001: runtime-uploaded media never belongs in git (keep .gitkeep)
/public/uploads/*
!/public/uploads/.gitkeep
